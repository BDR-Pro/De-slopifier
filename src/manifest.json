{
  "manifest_version": 3,
  "name": "De-slopifier",
  "version": "0.2.1",
  "description": "Filter X For You by your following network, hide detected promoted posts, and count blocked posts this session.",
  "permissions": [
    "storage",
    "activeTab",
    "identity",
    "alarms"
  ],
  "host_permissions": [
    "https://x.com/*",
    "https://www.x.com/*",
    "https://twitter.com/*",
    "https://www.twitter.com/*",
    "https://api.x.com/*"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "De-slopifier",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png"
    }
  },
  "options_ui": {
    "page": "settings.html",
    "open_in_tab": true
  },
  "content_scripts": [
    {
      "matches": [
        "https://x.com/*",
        "https://www.x.com/*",
        "https://twitter.com/*",
        "https://www.twitter.com/*"
      ],
      "js": [
        "core.js",
        "content.js"
      ],
      "css": [
        "content.css"
      ],
      "run_at": "document_idle"
    }
  ],
  "author": "Bader Alotaibi",
  "homepage_url": "https://github.com/BDR-Pro/De-slopifier",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "96": "icons/icon-96.png",
    "128": "icons/icon-128.png"
  },
  "background": {
    "service_worker": "background.js"
  },
  "minimum_chrome_version": "120"
}
